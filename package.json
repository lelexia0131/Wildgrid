{
  "name": "wildgrid",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "野格",
  "author": "Wildgrid",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "levels:check": "tsx scripts/check-levels.ts",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "test:ui": "electron tests/ui-smoke.cjs && electron tests/continuous-placement-ui.cjs",
    "icons": "node scripts/build-icons.mjs",
    "android:icons": "node scripts/build-android-icons.mjs",
    "android:sync": "npm run build && npm run android:icons && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "deploy:downloads": "node scripts/deploy-downloads.mjs",
    "desktop": "node node_modules/electron/install.js && npm run build && electron .",
    "package:win": "node node_modules/electron/install.js && npm run icons && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}

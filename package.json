{
  "name": "wildgrid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "野格 · 原创露营逻辑益智游戏",
  "author": "Wildgrid",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "electron tests/desktop-smoke.cjs",
    "icons": "node scripts/build-icons.mjs",
    "desktop": "node node_modules/electron/install.js && npm run build && electron .",
    "package:win": "node node_modules/electron/install.js && npm run icons && npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "sharp": "^0.35.5",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}

{
  "name": "wildgrid",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "野格",
  "author": "Wildgrid",
  "main": "electron/main.cjs",
  "scripts": {
    "art:3d": "node scripts/art-3d/build-art.mjs",
    "test:3d": "node --import tsx tests/ui/board-3d.mjs && node --import tsx tests/ui/camp-world.mjs",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test --test-concurrency=1 tests/**/*.test.ts",
    "levels:check": "tsx scripts/check-levels.ts",
    "test:desktop": "electron tests/ui/desktop-smoke.cjs",
    "test:ui": "electron tests/ui/ui-smoke.cjs && electron tests/ui/continuous-placement-ui.cjs",
    "icons": "node scripts/build-icons.mjs",
    "android:icons": "node scripts/build-android-icons.mjs",
    "android:sync": "npm run build && npm run android:icons && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "deploy:downloads": "node scripts/deploy-downloads.mjs",
    "desktop": "node node_modules/electron/install.js && npm run build && electron .",
    "package:win": "node scripts/package-windows.mjs",
    "steam:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/steam/build-steam.ps1",
    "steam:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/steam/upload-steam.ps1 -Mode Preflight",
    "steam:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/steam/upload-steam.ps1 -Mode Preview",
    "steam:upload": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/steam/upload-steam.ps1 -Mode Upload"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@gltf-transform/core": "4.5.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "meshoptimizer": "1.1.1",
    "playwright-core": "1.65.1",
    "proper-lockfile": "4.1.2",
    "semver": "6.3.1",
    "sharp": "^0.35.5",
    "three-mesh-bvh": "0.10.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}

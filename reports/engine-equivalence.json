    "command": "Run the following ES module from repository root using node --import tsx --input-type=module. It reads baseline sources from Git without writing files.",
    "lastRunOutput": { "solverLevels": 45, "evaluationCases": 779, "evaluationSha256": "1c91483cb752b4adf6bc5ca172002f15e978012261e0f363740049eddb86b42c", "passed": true },
    "script": "import { execFileSync } from 'node:child_process';\nimport { createHash } from 'node:crypto';\nimport assert from 'node:assert/strict';\nimport ts from 'typescript';\nimport { levels, solutions } from './src/engine/levels.ts';\nconst commit = 'ea4981ee70bb045468920d00132a113004a9d647';\nconst asModule = source => 'data:text/javascript;base64,' + Buffer.from(ts.transpile(source, { target: ts.ScriptTarget.ES2022, module: ts.ModuleKind.ESNext })).toString('base64');\nconst oldRulesUrl = asModule(execFileSync('git', ['show', commit + ':src/game/rules.ts'], { encoding: 'utf8' }));\nconst oldRules = await import(oldRulesUrl);\nconst oldSolver = await import(asModule(execFileSync('git', ['show', commit + ':src/game/solver.ts'], { encoding: 'utf8' }).replace(\"from './rules'\", \"from '\" + oldRulesUrl + \"'\")));\nconst currentRules = await import('./src/engine/rules.ts');\nconst currentSolver = await import('./src/engine/solver.ts');\nconst solve = engine => levels.map(level => ({ id: level.id, ...engine.solveLevel(level, 2, { maxNodes: 350000 }) }));\nconst evaluateAll = engine => levels.flatMap(level => [solutions[level.id], ...solutions[level.id].map(at => solutions[level.id].filter(p => p.id !== at.id)), ...solutions[level.id].map(at => solutions[level.id].map(p => p.id === at.id ? { ...p, r: (p.r + 1) % level.size } : p))].map(placements => engine.evaluate(level, placements)));\nconst before = solve(oldSolver), after = solve(currentSolver);\nassert.deepEqual(after, before);\nconst beforeEvaluation = evaluateAll(oldRules), afterEvaluation = evaluateAll(currentRules);\nassert.deepEqual(afterEvaluation, beforeEvaluation);\nconsole.log(JSON.stringify({ solverLevels: after.length, evaluationCases: afterEvaluation.length, evaluationSha256: createHash('sha256').update(JSON.stringify(afterEvaluation)).digest('hex'), passed: true }));\n"
